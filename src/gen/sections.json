{
  "legend": {
    ".": "rock",
    "#": "corridor",
    "+": "port corridor (sections attach here)",
    "E": "elevator shaft",
    "L": "ladder shaft",
    "A-Z (except E, L)": "room cells; the same letter = the same room; the same letter on two levels = a tall room entered from its lowest level"
  },
  "core": {
    "id": "core",
    "name": "Core",
    "levels": [
      [".QQL..", "K###E+", "KW#S..", "..+..."],
      [".GGL..", "X###E.", ".B#C..", "..+..."],
      [".GGL..", "...#E.", "...+..", "......"],
      ["......", "...+E.", "......", "......"]
    ],
    "rooms": {
      "Q": { "types": ["quarters"] },
      "K": { "types": ["kitchen"] },
      "W": { "types": ["water_plant"] },
      "S": { "types": ["storage"], "damagedChance": 0.5 },
      "G": { "types": ["geothermal"] },
      "X": { "types": ["empty"] },
      "B": { "types": ["boiler"] },
      "C": { "types": ["scrubber"], "damagedChance": 0.3 }
    },
    "ports": [
