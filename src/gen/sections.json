      { "at": [5, 0, 1], "dir": "+x" },
      { "at": [2, 1, 3], "dir": "+z" },
      { "at": [3, 2, 2], "dir": "+z" },
      { "at": [3, 3, 1], "dir": "-x" }
    ]
  },
